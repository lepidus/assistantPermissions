msgid "plugins.generic.editorialAdvisor.name"
msgstr "Editorial Advisor"

msgid "plugins.generic.editorialAdvisor.description"
msgstr "Adds recommendation-only and communication restrictions to Assistant roles in OMP."

msgid "plugins.generic.editorialAdvisor.blockContact"
msgstr "Prevent communication with authors and reviewers (keep their identities visible)"

msgid "plugins.generic.editorialAdvisor.denied"
msgstr "This action is not permitted for this editorial role."








msgid "plugins.generic.editorialAdvisor.readOnlyDiscussion"
msgstr "This discussion includes an author or reviewer and is available for reading only."

msgid "plugins.generic.editorialAdvisor.reviewerRecommendation.1"
msgstr "Accept"

msgid "plugins.generic.editorialAdvisor.reviewerRecommendation.2"
msgstr "Revisions required"

msgid "plugins.generic.editorialAdvisor.reviewerRecommendation.3"
msgstr "Resubmit for review"

msgid "plugins.generic.editorialAdvisor.reviewerRecommendation.4"
msgstr "Submit elsewhere"

msgid "plugins.generic.editorialAdvisor.reviewerRecommendation.5"
msgstr "Decline"

msgid "plugins.generic.editorialAdvisor.reviewerRecommendation.6"
msgstr "See comments"

msgid "plugins.generic.editorialAdvisor.restrictFiles"
msgstr "Allow read-only access to files"

msgid "plugins.generic.editorialAdvisor.restrictFiles.description"
msgstr "Allows viewing file details and downloading files. Prevents uploading, selecting, editing, replacing or deleting files."
